{
  "name": "chek-web",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "bun scripts/demo-data.ts && vite --mode demo",
    "build": "vite build",
    "build:server": "vite build --mode server --outDir dist-server",
    "preview": "vite preview",
    "typecheck": "tsc",
    "deploy": "vite build && bun scripts/cloudflare.ts && cf deploy --prebuilt",
    "deploy:demo": "bun scripts/demo-data.ts && vite build --mode demo && bun scripts/cloudflare.ts demo && bunx wrangler@4 deploy -c wrangler.demo.jsonc",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@kobalte/core": "0.13.14",
    "@readchek/reader": "github:readchek/chek-reader#854435e9883059cd75c2670138b386e8b27b5d5b",
    "@tanstack/solid-router": "1.170.43",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk-solid": "1.2.0",
    "pdfjs-dist": "6.4.299",
    "solid-js": "1.9.17",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.9.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "latest",
    "cf": "^1.0.0-beta.13",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.86.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.14"
  },
  "packageManager": "bun@1.4.3"
}
